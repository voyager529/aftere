# =============================================================================
# after-e- — environment contract   (.env.example)
# =============================================================================
# Copy to `.env` (chmod 600). The installer normally GENERATES this file from
# the questionnaire + answer file; this example documents every variable so a
# maintainer can see the whole configurable surface in one place.
#
# TWO CLASSES OF VALUE:
#   - Operator answers  : you set these (or the questionnaire does).
#   - Generated secrets : the installer mints these ONCE and caches them.
#                         Never regenerate on a re-run (see ARCHITECTURE.md).
# =============================================================================

# --- Paths -------------------------------------------------------------------
# Config/state (small, precious, always backed up) and bulk data (large,
# operator's separate backup choice) are SIBLINGS so they can point at
# different volumes independently. Default: both under /mnt/aftere on the
# system volume. Point AFTERE_DATA at a mounted block volume for the bulk tier.
AFTERE_CONFIG=/mnt/aftere/config
AFTERE_DATA=/mnt/aftere/data

# --- Identity / domain -------------------------------------------------------
AFTERE_DOMAIN=example.com
AFTERE_ADMIN_EMAIL=admin@example.com
TZ=Etc/UTC
PUID=1000
PGID=1000

# --- Tier selection ----------------------------------------------------------
# Docker Compose reads COMPOSE_PROFILES to decide which optional services start.
# The installer sets this from the chosen tier:
#   Kitchen Sink (default) : mail,photos,vault
#   Everything but Mail    : photos,vault
#   NC Handles My Photos   : mail,vault
#   File Sync Only         : (empty)
# Always-on regardless of tier: nginx, authentik(+db+ldap), redis, nextcloud(+db), crowdsec
COMPOSE_PROFILES=mail,photos,vault

# --- Immich machine learning -------------------------------------------------
# Only meaningful when the `photos` profile is active. ML adds ~1-2 GB RAM and
# is CPU-bursty. Recommended off (or offloaded) on a 2C/8GB box. This flag is
# consumed by the installer to include/exclude the immich-ml service.
AFTERE_IMMICH_ML=yes

# --- Mail delivery mode ------------------------------------------------------
# Set by init.sh (the decision) + relay-setup.sh (the credentials).
# direct = this host delivers outbound itself via MX (PTR matters; often spam-filtered).
# relay  = outbound via an authenticated SMTP relay (PTR irrelevant; inbound still
#          arrives at your MX directly).
MAIL_OUTBOUND_MODE=direct
# Relay settings (only used when MAIL_OUTBOUND_MODE=relay). These are written by
# relay-setup.sh after its swaks preflight — you don't hand-edit them here.
# TLS PAIRING: port 465 -> RELAY_IMPLICIT_TLS=true ; 587 or 2525 -> false (STARTTLS).
RELAY_HOST=
RELAY_PORT=465
RELAY_IMPLICIT_TLS=true          # 465 -> true ; 587/2525 -> false
RELAY_ALLOW_INVALID_CERTS=false  # true only if the relay presents a bad cert
RELAY_USER=
RELAY_PASSWORD=                  # generated? NO — operator-supplied credential

# --- Certificate mode --------------------------------------------------------
# http01     = ACME HTTP-01 (needs every hostname resolving + port 80 open)
# cloudflare = ACME DNS-01 via Cloudflare (scoped token; enables wildcard)
# byo        = bring your own cert files (no issuance; renewal becomes monitor)
AFTERE_CERT_MODE=http01
CF_API_TOKEN=              # scoped Zone:DNS:Edit token ONLY (never global key)
BYO_CERT_DIR=              # path to fullchain.pem + privkey.pem when mode=byo

# =============================================================================
# GENERATED SECRETS  — installer mints once, caches, never regenerates.
# Placeholders below use the questionnaire's @@@generate@@@ token convention:
#   @@@generate@@@:<len>@    mixed alnum
#   @@@generate@@@:l:<len>@  lower+digits    :u:<len>@  upper+digits
# =============================================================================

# Postgres (one instance per service — see ARCHITECTURE.md DB topology)
PG_AUTHENTIK_PASSWORD=@@@generate@@@:l:40@
PG_NEXTCLOUD_PASSWORD=@@@generate@@@:l:40@
PG_IMMICH_PASSWORD=@@@generate@@@:l:40@

# Authentik core + bootstrap
AUTHENTIK_SECRET_KEY=@@@generate@@@:60@
AUTHENTIK_BOOTSTRAP_PASSWORD=@@@generate@@@:24@   # initial akadmin pw; change on first login
AUTHENTIK_BOOTSTRAP_TOKEN=@@@generate@@@:l:40@    # API token used to verify blueprints applied

# Nextcloud admin (created in postinstall via occ)
NEXTCLOUD_ADMIN_USER=ncadmin
NEXTCLOUD_ADMIN_PASSWORD=@@@generate@@@:24@

# Immich DB identity (DB_* map to POSTGRES_* in the immich-db service)
IMMICH_DB_USERNAME=immich
IMMICH_DB_DATABASE=immich

# Vaultwarden admin panel token (argon2 hash recommended at QA; plain for draft)
VAULTWARDEN_ADMIN_TOKEN=@@@generate@@@:40@

# OIDC client secrets — generate-and-inject into BOTH the Authentik blueprint
# and each service's config. Same value both sides = no read-back step.
OIDC_NEXTCLOUD_SECRET=@@@generate@@@:50@
OIDC_IMMICH_SECRET=@@@generate@@@:50@
OIDC_VAULTWARDEN_SECRET=@@@generate@@@:50@
OIDC_ROUNDCUBE_SECRET=@@@generate@@@:50@

# LDAP outpost service-account bind password (Stalwart + Nextcloud bind with this)
LDAP_BIND_PASSWORD=@@@generate@@@:40@

# Authentik LDAP outpost token (issued by Authentik; the outpost authenticates
# to core with it). Generated here and set on the outpost's blueprint.
AUTHENTIK_LDAP_TOKEN=@@@generate@@@:l:40@
